# WordWright (read-only capability token in the URL path)
WORDWRIGHT_TOKEN=wwt_replace_me
WORDWRIGHT_SLUG=my-draft-slug

# GitHub (fine-grained PAT, scoped to this repo only)
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPO=owner/name

# Gmail draft recipient (the operator's own address)
SHIP_NOTIFY_EMAIL=you@example.com
